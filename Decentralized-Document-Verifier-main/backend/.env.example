# ─────────────────────────────────────────────────────────────
#  backend/.env.example  —  TrueDocs v2
#  Copy to backend/.env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Pinata (IPFS) ────────────────────────────────────────────
PINATA_JWT=

# ── Blockchain ───────────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
PRIVATE_KEY=

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docverifier

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Admin account ────────────────────────────────────────────
ADMIN_EMAIL=admin@truedocs.dev
# Used ONLY by the seed script to create the admin the first time
ADMIN_SEED_PASSWORD=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@truedocs.local

# Set to "true" to log emails to console without actually sending
SMTP_DEV_MODE=true

# ── Demo org seeds (used by seed.py) ─────────────────────────
DEMO_ORG_A_EMAIL=demo-org-a@truedocs.local
DEMO_ORG_A_PASSWORD=DemoOrgA@2024!
DEMO_ORG_B_EMAIL=demo-org-b@truedocs.local
DEMO_ORG_B_PASSWORD=DemoOrgB@2024!
